---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ReportFrame from '../../components/ReportFrame.astro';
import PdfEmbed from '../../components/PdfEmbed.astro';
import PdfSpread from '../../components/PdfSpread.astro';
import NotebookSet from '../../components/NotebookSet.astro';
import ReportSet from '../../components/ReportSet.astro';

export async function getStaticPaths() {
  const all = await getCollection('projects');
  return all.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}
const { project } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const fmt = (x: Date) => x.toLocaleDateString('en-GB', { year: 'numeric', month: 'long' });
---
<Base title={`${d.title} — Katie Knox`}>
  <article class="case">
    <p class="crumb"><a href="/work">All work</a> / {d.title}</p>
    <h1 class="case__title">{d.title}</h1>
    <p class="case__summary">{d.summary}</p>

    <dl class="case__meta">
      <div><dt>Date</dt><dd><time datetime={d.date.toISOString()}>{fmt(d.date)}</time></dd></div>
      <div><dt>Type</dt><dd>{d.kind}</dd></div>
      {d.course && <div><dt>Course</dt><dd>{d.course}</dd></div>}
      <div>
        <dt>Role</dt>
        <dd>{d.role}</dd>
      </div>
      {d.collaborators?.length ? (
        <div><dt>With</dt><dd>{d.collaborators.join(', ')}</dd></div>
      ) : null}
    </dl>

    <Image class="case__cover" src={d.cover} alt="" widths={[800, 1600]}
           sizes="(max-width: 54rem) 100vw, 60rem" />

    <div class="case__tags">
      {[...d.tags, ...d.themes].map((t) => <a class="chip" href={`/work/tag/${t}`}>{t}</a>)}
    </div>

    <div class="case__body"><Content /></div>

    {d.reports?.length ? <ReportSet slug={project.id} reports={d.reports} /> : null}
    {!d.reports?.length && d.links.report && <ReportFrame src={d.links.report} title={`${d.title} — full analysis`} />}
    {d.notebooks?.length ? <NotebookSet slug={project.id} notebooks={d.notebooks} /> : null}
    {d.links.pdf && (d.pdfDisplay === 'spread'
      ? <PdfSpread slug={project.id} title={d.title} pages={d.pdfPages ?? 0} />
      : <PdfEmbed  slug={project.id} title={d.title} pages={d.pdfPages ?? 0} />)}

    {(d.links.code || d.links.live || d.links.slides) && (
      <p class="case__links">
        {d.links.code  && <a href={d.links.code}  rel="noopener">Code ↗</a>}
        {d.links.live  && <a href={d.links.live}  rel="noopener">Live ↗</a>}
        {d.links.slides && <a href={d.links.slides} rel="noopener">Slides ↗</a>}
      </p>
    )}
  </article>
</Base>
<style>
  .case { max-width: 62rem; }
  .crumb { font-family: var(--face-mono); font-size: var(--step--1); color: var(--ink-faint); margin: 0 0 var(--s-3); }
  .crumb a { color: inherit; }
  .case__title { font-size: var(--step-3); line-height: 1.1; margin: 0 0 var(--s-4); letter-spacing: -0.01em; }
  .case__summary { font-size: var(--step-1); color: var(--ink-soft); max-width: var(--measure); margin: 0 0 var(--s-6); }
  .case__meta {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--s-4); margin: 0 0 var(--s-6);
    border-block: 1px solid var(--rule); padding-block: var(--s-4);
  }
  .case__meta dt {
    font-family: var(--face-mono); font-size: 0.72rem; text-transform: uppercase;
    letter-spacing: 0.12em; color: var(--ink-faint);
  }
  .case__meta dd { margin: var(--s-1) 0 0; font-size: var(--step--1); }
  .case__cover { width: 100%; border: 1px solid var(--rule); background: #fff; }
  .case__tags { display: flex; flex-wrap: wrap; gap: var(--s-2); margin: var(--s-5) 0; }
  .chip {
    font-family: var(--face-mono); font-size: 0.72rem; letter-spacing: 0.06em;
    text-transform: uppercase; text-decoration: none; color: var(--ink-soft);
    border: 1px solid var(--rule-strong); padding: var(--s-1) var(--s-3); border-radius: 2px;
  }
  .chip:hover { border-color: var(--water); color: var(--water); }
  .case__body { max-width: var(--measure); }
  .case__links { display: flex; gap: var(--s-5); margin-top: var(--s-6); }
  .case__links a {
    font-family: var(--face-mono); font-size: var(--step--1);
    border-bottom: 1.5px solid var(--rule-strong); text-decoration: none;
  }
  .case__links a:hover { color: var(--water); border-color: var(--water); }
</style>
