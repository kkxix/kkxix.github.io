---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Plate from '../components/Plate.astro';

const all = (await getCollection('projects'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = all.filter((p) => p.data.featured);
const rest = all.filter((p) => !p.data.featured);
const roman = ['PL. I','PL. II','PL. III','PL. IV','PL. V','PL. VI','PL. VII','PL. VIII'];
---
<Base title="Katie Knox — planning and spatial analysis">
  <header class="banner">
    <h1 class="banner__tagline">Equitable access to essential infrastructure</h1>
    <p class="banner__bio">
      Urban planner and data scientist working on infrastructure access, from
      broadband, to shelter, to drinking water. I am motivated by the question of who
      gets left out of essential infrastructure, how data can become evidence, and
      how we should act to make our environments livable for everyone.
    </p>
  </header>

  <h2 class="rule-head">Featured</h2>
  <ol class="plate-grid">
    {featured.map((p, i) => <Plate project={p} plate={roman[i]} />)}
  </ol>

  <h2 class="rule-head">Further work</h2>
  <ol class="plate-grid plate-grid--small">
    {rest.map((p, i) => <Plate project={p} plate={roman[featured.length + i]} />)}
  </ol>
</Base>

<style>
  .banner { max-width: 60ch; margin-bottom: var(--s-8); }
  .banner__tagline {
    display: inline-block;
    background: var(--highlight-bg);
    color: var(--highlight-ink);
    font-size: var(--step-2); line-height: 1.2; font-weight: 600;
    letter-spacing: -0.01em; text-wrap: balance;
    margin: 0; padding: 0.3em 0.7em; border-radius: 999px;
  }
  .banner__bio {
    font-size: var(--step-1); line-height: 1.45; color: var(--ink);
    margin: var(--s-5) 0 0; max-width: 52ch; text-wrap: pretty;
  }
  .rule-head {
    font-family: var(--face-mono); font-size: var(--step--1); font-weight: 400;
    text-transform: uppercase; letter-spacing: 0.16em; color: var(--ink-faint);
    border-bottom: 1.5px solid var(--ink); padding-bottom: var(--s-2);
    margin: var(--s-8) 0 var(--s-5);
  }
  .rule-head:first-of-type { margin-top: 0; }
  .plate-grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: var(--s-5);
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
  }
  .plate-grid--small { grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
</style>
