---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const all = (await getCollection('writing'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const research = all.filter((i) => ['preprint','poster'].includes(i.data.type));
const practice = all.filter((i) => !['preprint','poster'].includes(i.data.type));
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long' });
---
<Base title="Writing — Katie Knox">
  <h1 class="page-title">Writing and talks</h1>
  <p class="page-lede">
    Practitioner writing on digital equity and broadband policy, plus research from
    earlier work. Published pieces are bylined <b>Katie Knox Mimoune</b>; coursework
    and code elsewhere on this site appear under Katie Knox.
  </p>

  <h2 class="rule-head">Practice</h2>
  <ul class="entries">
    {practice.map((it) => (
      <li class="entry">
        <p class="entry__meta">
          <span class={`pill pill--${it.data.type}`}>{it.data.type}</span>
          <span>{it.data.outlet}</span><span aria-hidden="true">·</span>
          <time datetime={it.data.date.toISOString()}>{fmt(it.data.date)}</time>
        </p>
        <h3 class="entry__title"><a href={it.data.url} rel="noopener">{it.data.title}</a></h3>
        {it.data.takeaway && <p class="entry__take">{it.data.takeaway}</p>}
        {it.data.statusNote && <p class="entry__status">{it.data.statusNote}</p>}
        <p class="entry__byline">{it.data.byline}</p>
      </li>
    ))}
  </ul>

  <h2 class="rule-head">Research</h2>
  <p class="note">
    Neither of the items below has been through peer review. The first is an arXiv
    preprint; the second is a course project report that was presented as a
    conference poster. They are listed because the work is real and citable, not as
    peer-reviewed publications.
  </p>
  <ul class="entries">
    {research.map((it) => (
      <li class="entry">
        <p class="entry__meta">
          <span class={`pill pill--${it.data.type}`}>{it.data.type}</span>
          <span>{it.data.outlet}</span><span aria-hidden="true">·</span>
          <time datetime={it.data.date.toISOString()}>{fmt(it.data.date)}</time>
        </p>
        <h3 class="entry__title">
          {it.data.url
            ? <a href={it.data.url} rel="noopener">{it.data.title}</a>
            : <a href={it.data.pdf}>{it.data.title}</a>}
        </h3>
        {it.data.venueNote && <p class="entry__venue">{it.data.venueNote}</p>}
        {it.data.takeaway && <p class="entry__take">{it.data.takeaway}</p>}
        {it.data.authors && (
          <p class="entry__authors">
            {it.data.authors.map((a, i) => (
              <>{i > 0 && ', '}<span class={a.includes('Knox') ? 'is-me' : ''}>{a}</span></>
            ))}
          </p>
        )}
        <p class="entry__links">
          {it.data.url && <a href={it.data.url} rel="noopener">arXiv ↗</a>}
          {it.data.pdf && <a href={it.data.pdf}>PDF</a>}
        </p>
      </li>
    ))}
  </ul>
</Base>
<style>
  .page-title { font-size: var(--step-3); margin: 0 0 var(--s-4); letter-spacing: -0.01em; }
  .page-lede { max-width: var(--measure); color: var(--ink-soft); margin: 0 0 var(--s-7); }
  .rule-head {
    font-family: var(--face-mono); font-size: var(--step--1); font-weight: 400;
    text-transform: uppercase; letter-spacing: 0.16em; color: var(--ink-faint);
    border-bottom: 1.5px solid var(--ink); padding-bottom: var(--s-2);
    margin: var(--s-8) 0 var(--s-4);
  }
  .note {
    max-width: var(--measure); color: var(--ink-soft); font-size: var(--step--1);
    border-left: 2px solid var(--warn); padding-left: var(--s-4); margin: 0 0 var(--s-5);
  }
  .entries { list-style: none; margin: 0; padding: 0; max-width: 62ch; }
  .entry { border-top: 1px solid var(--rule); padding-block: var(--s-5); }
  .entry__meta {
    display: flex; flex-wrap: wrap; gap: var(--s-3); align-items: center;
    font-family: var(--face-mono); font-size: 0.72rem; text-transform: uppercase;
    letter-spacing: 0.1em; color: var(--ink-faint); margin: 0 0 var(--s-3);
  }
  .pill { border: 1px solid currentColor; padding: 1px var(--s-2); border-radius: 2px; }
  .pill--article  { color: var(--accent); }
  .pill--toolkit  { color: var(--warn); }
  .pill--talk     { color: var(--warn); }
  .pill--preprint { color: var(--warn); }
  .pill--poster   { color: var(--warn); }
  .entry__title { font-size: var(--step-1); line-height: 1.25; margin: 0; font-weight: 600; }
  .entry__title a { text-decoration: none; border-bottom: 1.5px solid var(--rule-strong); }
  .entry__title a:hover { color: var(--accent); border-color: var(--accent); }
  .entry__venue {
    font-family: var(--face-mono); font-size: 0.72rem; color: var(--warn);
    margin: var(--s-2) 0 0;
  }
  .entry__take { color: var(--ink-soft); margin: var(--s-3) 0 0; }
  .entry__authors { font-size: var(--step--1); color: var(--ink-faint); margin: var(--s-3) 0 0; }
  .entry__authors .is-me { color: var(--ink); font-weight: 600; }
  .entry__status {
    font-size: var(--step--1); color: var(--ink-soft);
    border-left: 2px solid var(--warn); padding-left: var(--s-3);
    margin: var(--s-3) 0 0;
  }
  .entry__byline {
    font-family: var(--face-mono); font-size: 0.72rem; color: var(--ink-faint);
    margin: var(--s-3) 0 0;
  }
  .entry__links { display: flex; gap: var(--s-4); margin: var(--s-3) 0 0; }
  .entry__links a {
    font-family: var(--face-mono); font-size: var(--step--1); color: var(--ink-soft);
    border-bottom: 1.5px solid var(--rule-strong); text-decoration: none;
  }
  .entry__links a:hover { color: var(--accent); border-color: var(--accent); }
</style>
