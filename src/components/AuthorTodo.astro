---
// Dev-only marker. Renders a visible box in `astro dev`, nothing in production.
const { note } = Astro.props;
const dev = import.meta.env.DEV;
---
{dev && (
  <aside class="authortodo">
    <b>AUTHOR</b>
    <span>{note}</span>
  </aside>
)}
<style>
  .authortodo {
    display: flex; gap: var(--s-3); align-items: baseline;
    background: var(--highlight-bg);
    color: var(--highlight-ink);
    border: 0; border-radius: 999px;
    padding: var(--s-3) var(--s-5); margin-block: var(--s-4);
    font-family: var(--face-mono); font-size: var(--step--1);
  }
  .authortodo b { letter-spacing: 0.12em; color: var(--highlight-ink); flex: none; }
</style>
