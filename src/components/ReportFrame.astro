---
// Embeds a rendered Quarto report from public/reports/<slug>/.
const { src, title } = Astro.props;
---
<figure class="reportframe">
  <div class="reportframe__bar">
    <span>{title}</span>
    <a href={src} rel="noopener">Open in new tab ↗</a>
  </div>
  <iframe src={src} title={title} loading="lazy"></iframe>
</figure>
<style>
  .reportframe { margin: var(--s-6) 0; border: 1px solid var(--rule); background: var(--ground-raised); }
  .reportframe__bar {
    display: flex; justify-content: space-between; gap: var(--s-4); align-items: center;
    padding: var(--s-3) var(--s-4); border-bottom: 1px solid var(--rule);
    font-family: var(--face-mono); font-size: var(--step--1); color: var(--ink-soft);
  }
  .reportframe iframe { width: 100%; height: min(85vh, 900px); border: 0; display: block; background: #fff; }
</style>
