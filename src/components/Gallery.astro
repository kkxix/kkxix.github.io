---
import { Image, getImage } from 'astro:assets';
// Figure grid. Each figure links to the full-size image, so it works with
// JavaScript disabled; the script upgrades it to a keyboard-accessible dialog.
const { title, intro, figures } = Astro.props;
// image.src points at the unprocessed original, which Astro does not emit — only
// the variants it generates. Build a large variant explicitly for the lightbox.
const full = await Promise.all(
  figures.map((f) => getImage({ src: f.src, width: 1600, format: 'webp' }))
);
---
<section class="gal">
  {title && <h2 class="gal__head">{title}</h2>}
  {intro && <p class="gal__intro">{intro}</p>}
  <ul class="gal__grid">
    {figures.map((f, i) => (
      <li class="gal__item">
        <a class="gal__link" href={full[i].src} data-caption={f.caption}>
          <Image src={f.src} alt={f.caption} widths={[400, 900]}
                 sizes="(max-width: 54rem) 100vw, 22rem" />
          <span class="gal__cap">{f.caption}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<dialog class="lightbox" aria-label="Enlarged figure">
  <button class="lightbox__close" type="button" aria-label="Close">×</button>
  <img class="lightbox__img" src="" alt="" />
  <p class="lightbox__cap"></p>
</dialog>

<script>
  const dlg = document.querySelector('.lightbox') as HTMLDialogElement | null;
  if (dlg && typeof dlg.showModal === 'function') {
    const img = dlg.querySelector('.lightbox__img') as HTMLImageElement;
    const cap = dlg.querySelector('.lightbox__cap') as HTMLElement;
    document.querySelectorAll('.gal__link').forEach((a) => {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        const el = a as HTMLAnchorElement;
        img.src = el.href;
        img.alt = el.dataset.caption ?? '';
        cap.textContent = el.dataset.caption ?? '';
        dlg.showModal();
      });
    });
    dlg.querySelector('.lightbox__close')?.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  }
</script>

<style>
  .gal { margin: var(--s-8) 0; }
  .gal__head {
    font-family: var(--face-mono); font-size: var(--step--1); font-weight: 400;
    text-transform: uppercase; letter-spacing: 0.16em; color: var(--ink-faint);
    border-bottom: 1.5px solid var(--ink); padding-bottom: var(--s-2); margin: 0 0 var(--s-4);
  }
  .gal__intro { color: var(--ink-soft); max-width: var(--measure); margin: 0 0 var(--s-5); }
  .gal__grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: var(--s-4);
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }
  .gal__item { border: 1px solid var(--rule); background: var(--ground-raised); }
  .gal__link { display: block; text-decoration: none; }
  .gal__link :global(img) { width: 100%; height: auto; display: block; background: #fff; }
  .gal__link:hover { outline: 2px solid var(--accent); outline-offset: -2px; }
  .gal__cap {
    display: block; padding: var(--s-3);
    font-size: var(--step--1); color: var(--ink-soft);
    border-top: 1px solid var(--rule);
  }
  .lightbox {
    border: 1px solid var(--rule-strong); background: var(--ground-raised);
    color: var(--ink); max-width: min(94vw, 70rem); max-height: 92vh; padding: var(--s-4);
  }
  .lightbox::backdrop { background: rgb(0 0 0 / 0.7); }
  .lightbox__img { max-width: 100%; max-height: 78vh; display: block; margin-inline: auto; background: #fff; }
  .lightbox__cap { margin: var(--s-3) 0 0; font-size: var(--step--1); color: var(--ink-soft); text-align: center; }
  .lightbox__close {
    position: absolute; top: var(--s-2); right: var(--s-3);
    background: none; border: 0; color: var(--ink-soft);
    font-size: var(--step-2); line-height: 1; cursor: pointer;
  }
  .lightbox__close:hover { color: var(--warn); }
</style>
