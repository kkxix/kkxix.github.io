---
import '../styles/tokens.css';
import { Image } from 'astro:assets';
// Any image dropped in src/assets/portrait/ becomes the sidebar portrait, so the
// filename does not matter. Absent a file, the sidebar simply has no portrait.
const portraits = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/portrait/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const portrait = Object.values(portraits)[0]?.default ?? null;
interface Props { title: string; section?: 'work' | 'writing' | 'about' | 'cv' | null }
const { title, section = null } = Astro.props;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
</head>
<body data-section={section}>
  <a class="skip" href="#main">Skip to content</a>
  <div class="shell">
    <aside class="legend" aria-label="Site navigation">
      <div>
        <p class="legend__eyebrow">Portfolio</p>
        <a class="legend__name" href="/">Katie Knox</a>
        {portrait && (
          <Image class="legend__portrait" src={portrait} alt="Katie Knox"
                 widths={[220, 440]} sizes="14rem" loading="eager" />
        )}
      </div>
      <nav class="legend__nav" aria-label="Sections">
        <a href="/work" data-section="work"><span class="key key--chartreuse"></span>Work</a>
        <a href="/writing" data-section="writing"><span class="key key--section"></span>Writing</a>
        <a href="/about" data-section="about"><span class="key key--section"></span>About</a>
        <a href="/cv" data-section="cv"><span class="key key--section"></span>CV</a>
      </nav>
      <dl class="legend__meta">
        <div><dt>Discipline</dt><dd>Planning &amp; spatial analysis</dd></div>
        <div><dt>Based</dt><dd>Philadelphia</dd></div>
      </dl>
    </aside>
    <main id="main" class="main"><slot /></main>
  </div>
<style is:global>
  .shell { display: grid; grid-template-columns: 17rem 1fr; min-height: 100vh; }
  .legend {
    border-right: 1px solid var(--rule); background: var(--ground-sunk);
    padding: var(--s-6) var(--s-5); display: flex; flex-direction: column;
    gap: var(--s-7); position: sticky; top: 0; height: 100vh;
  }
  .legend__eyebrow {
    font-family: var(--face-mono); font-size: var(--step--1); letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--ink-faint); margin: 0 0 var(--s-3);
  }
  .legend__name {
    font-size: var(--step-2); line-height: 1.05; letter-spacing: -0.01em;
    text-decoration: none; display: inline-block;
  }
  .legend__portrait {
    width: 100%; height: auto; display: block;
    margin-top: var(--s-4); border-radius: var(--s-2);
    /* The source is a full-length portrait; crop square onto the head and
       shoulders so the face is legible at sidebar size. */
    aspect-ratio: 1 / 1; object-fit: cover; object-position: 56% 9%;
  }
  .legend__nav { display: flex; flex-direction: column; gap: var(--s-3); }
  .legend__nav a {
    display: flex; align-items: center; gap: var(--s-3);
    font-family: var(--face-ui); text-decoration: none; padding: var(--s-2) 0;
  }
  .legend__nav a:hover { color: var(--accent); }
  .key { width: 1.1rem; height: 0.7rem; border-radius: 999px; flex: none; }
  /* Each swatch takes its own section's accent, so the key matches the colour
     that page actually uses. */
  .key--section { background: var(--accent); }
  .key--chartreuse { background: var(--highlight-bg); }
  .legend__meta { margin: auto 0 0; display: grid; gap: var(--s-4); }
  .legend__meta dt {
    font-family: var(--face-mono); font-size: 0.72rem; text-transform: uppercase;
    letter-spacing: 0.12em; color: var(--ink-faint);
  }
  .legend__meta dd { margin: var(--s-1) 0 0; font-size: var(--step--1); }
  .main { padding: var(--s-7) var(--gutter) var(--s-9); min-width: 0; }
  .todo {
    background: var(--highlight-bg);
    color: var(--highlight-ink);
    box-decoration-break: clone;
    padding: 0.15em 0.6em;
    border-radius: 999px;
    font-family: var(--face-mono); font-size: var(--step-0);
  }
  @media print {
    /* Printing a page (the CV in particular) should produce the document, not
       the site chrome around it. */
    .legend, .skip { display: none !important; }
    .shell { display: block; }
    .main { padding: 0; }
    body { background: #fff; color: #000; }
  }
  @media (max-width: 54rem) {
    .shell { grid-template-columns: 1fr; }
    .legend { position: static; height: auto; border-right: 0; border-bottom: 1px solid var(--rule); gap: var(--s-5); }
    .legend__nav { flex-direction: row; flex-wrap: wrap; gap: var(--s-5); }
    /* Full width, the portrait would fill the first screen on a phone. */
    .legend__portrait { max-width: 7rem; margin-top: var(--s-3); }
    .legend__meta { margin-top: 0; grid-template-columns: repeat(auto-fit, minmax(10rem,1fr)); }
  }
</style>
</body>
</html>
